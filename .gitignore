# Game image and derived binaries — kept LOCAL only, never committed.
# revs.ssd is the copyrighted source disc image; everything under disasm/files/ and
# revs_mem.bin is derived from it, so it is equally not ours to distribute.
*.ssd
*.dsd
*.uef
*.d64
disasm/files/
disasm/revs_mem.bin
disasm/revs_runtime.bin
disasm/revs_dashcode.bin
disasm/revs_blocks.txt

# Screenshots / comparison captures — local only.
*.png

# Large / regenerable artifacts
# (gitignore has no inline-comment syntax -- a trailing "# ..." on a pattern line
# is taken as literal glob text and matches nothing, so comments go on their own line)
# tools/ghidra -- extracted Ghidra install (~2 GB), symlinked to a shared install
# at ~/.local/share/ghidra (also used by the Rescue on Fractalus repo). No trailing
# slash: a trailing-slash gitignore pattern only matches a real directory, not a
# symlink to one.
tools/ghidra
# tools/ghidra-proj/ -- Ghidra project (the annotation DB) -- large, machine-local
tools/ghidra-proj/
# tools/jsbeeb/ -- vendored jsbeeb checkout, the BBC reference-loop oracle (docs/bbc-reference-loop.md)
tools/jsbeeb/
# tools/b2/ -- vendored b2 checkout, if/when built
tools/b2/
tools/__pycache__/
*.zip

# Generated, regenerable from revs.ssd via the tools
disasm/listing.txt
disasm/dashcode.txt
# the entry-point sweep report (make sweep) -- regenerable; its CONCLUSIONS live in
# docs/static-map.md, which is committed
disasm/sweep.txt

# Generated C (regenerate with: make gen)
src/gen/revs_gen.c
src/gen/revs_decl.h
src/gen/mem.h
src/gen/revs_validate_list.h

# Build output
build/
*.o
*.d
*.rep
*.lock
amiga/obj/
amiga/out/
amiga/.run/

# Local probe/debug scratch — savestates, RAM dumps, ad-hoc probe scripts.
# Regenerable / disposable; committed probes are the *.gdb files, not these.
/tmp/
*.dat
tools/live_*.sh
amiga/*_probe.sh

# OS
.DS_Store
