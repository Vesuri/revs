diff --git a/src/platform/amiga/RevsPlot.cpp b/src/platform/amiga/RevsPlot.cpp
index 3d16f05..12a51e3 100644
--- a/src/platform/amiga/RevsPlot.cpp
+++ b/src/platform/amiga/RevsPlot.cpp
@@ -15,6 +15,11 @@
 #include "../../cpu/mem_decl.h"
 #include "../../cpu/m68k_math.h"   /* the 68000 has NO 32-bit mul/div (make muldiv-audit) */
 #include "../../gen/mem.h"         /* MEM_<name> offsets — NEEDLEVERIFY reads the undo list */
+#ifdef REVS_TERRAIN_BLIT
+#include <proto/exec.h>             /* AllocMem: the toggle buffers are the blitter's, so CHIP */
+#include <exec/memory.h>
+#include <exec/execbase.h>          /* AttnFlags: the blitter is chosen by CPU */
+#endif
 
 extern "C" MEM_QUAL uint8_t mem[65536];
 
@@ -531,6 +536,219 @@ extern "C" { volatile unsigned long g_terrainRowBad = 0; }     /* ⚠⚠ MUST BE
 
 extern "C" void revs_plot_terrain_stale(void) { TSIG_STALE(); }
 
+#ifdef REVS_TERRAIN_BLIT
+/* ⭐⭐⭐ THE BLITTER TERRAIN — the terrain rows are an AREA FILL, and the CPU writes only the edges.
+   ============================================================================================
+   A line is `view_consume`'s RLE: an entry byte up to the first event, each event's byte up to the
+   next.  The painter above stores all eighty plane bytes of every changed line.  The Amiga has a
+   coprocessor built for exactly this shape: the blitter's EXCLUSIVE FILL, run DESCENDING, walks each
+   row from its right end and outputs, per pixel, the XOR of every source bit at or to the right of
+   it (it resets at every row, so the interleaved plane rows are independent).  So a row D is
+   reproduced exactly by the TOGGLE row T[x] = D[x] ^ D[x+1] (D past the right edge = 0) — a bit
+   wherever a pixel differs from its right neighbour — and for a run of a SOLID colour byte that is
+   zero everywhere except its LAST cell.  ⇒ per run the CPU writes one byte a plane, into a
+   chip-RAM buffer the blitter cleared, and one blit a block paints the rows while the CPU goes on
+   with the frame.
+   In bytes (bit 7 is a cell's leftmost pixel): T_c = D_c ^ (D_c << 1) ^ msb(D_{c+1}).  With
+   A(b) = (D ^ (D << 1)) & $FF and M(b) = D >> 7 per plane, a run of byte `a` over cells [s, e)
+   followed by byte `n` is:
+       T_{e-1} = A(a) ^ M(n)                 (M = 0 past cell 39)
+       T_c     = A(a) ^ M(a)   for s <= c < e-1, which is ZERO iff `a` is solid in that plane
+   so only a non-solid run longer than a cell costs more than its end.
+   ⭐⭐ THE SCAN WRITES THEM (scan_tog_m68k.s), so on this path there are no event lists at all:
+     at each source it finds, the scan knows the line's previous colour and stores
+     T_{c-1} = A(prev) ^ M(new) straight into the line's toggle row.  The one thing it cannot
+     know is the line's ENTRY byte, which the drivers publish after it (g_viewRowBg), so the
+     scan treats the entry as colour 0 (A = M = K = 0) and `togFix` below XORs A(entry) in at
+     the first event once the block is painted — and writes the line's last cell, whose run
+     ends at the right edge.  Only the grip probe's line still gets an event list.
+   ⚠ TWO TOGGLE BUFFERS, ALTERNATING BY SWEEP: the blitter clears the one the LAST sweep used when
+     this sweep starts, so the CPU never waits for a clear and never writes a buffer being read.
+   ⚠ ASYNCHRONOUS — `revs_plot_blit_sync()` before anything else writes these rows (the tyre
+     outline and the conversion in `prepareFrame`) and before the buffer can be presented.
+   ⚠ The row signatures above describe the ASM painter's writes, so this path marks them stale.
+   ⭐⭐ AND IT IS CHOSEN AT RUN TIME, BY CPU (user decision): the blitter pays on a 68000, whose
+     every store costs a bus cycle it cannot hide; a 68020 or better paints faster itself (and its
+     cache keeps the painter's loop off the bus), so there the asm painter above stays in charge.
+     `make TERRAINBLIT_FORCE=0|1` overrides the choice for testing either arm on either machine. */
+#define TOG_Y0    80u
+#define TOG_ROWS  81u                   /* sweep line L is display row 160 - L: rows 80..160 */
+extern "C" { volatile unsigned long g_terrainBlits = 0; }
+extern "C" { volatile unsigned char g_terrainBlitOn = 0; }   /* the run-time choice, for gdb */
+extern "C" { volatile unsigned long g_togMapBad = 0; }        /* ⚠⚠ MUST BE 0 */
+static uint8_t* s_tog[2];               /* chip RAM, TOG_ROWS * kRowBytes each */
+static uint8_t  s_togCur, s_togDirty[2], s_togFlip = 1u, s_togInited, s_togOn, s_togTabBuilt;
+/* Per SOURCE byte s (and record 256 for the colour $55 itself, which a source can only reach as
+   0): {colour = view_cell_bytes[s], 0, A lo, A hi, M lo, M hi, K lo, K hi} with K = A ^ M — the
+   scan's whole colour knowledge in one 8-byte record, so a hit is one index shift. */
+static uint8_t  s_togTab[257][8] __attribute__((aligned(2)));
+/* Per sweep line, what the scan leaves for `togFix`: the last colour's record offset, where
+   that run started ($FF: no event yet), the first event's cell ($FF: none), and the row. */
+struct TogRec { uint16_t prev; uint8_t prevc, firstc; uint8_t* row; };
+extern "C" ViewSpan* g_viewEvEnd[80];
+static TogRec   s_togRec[80];
+
+extern "C" unsigned view_scan_tog_m68k(MEM_QUAL uint8_t* src, const uint8_t* floor,
+                                       const uint8_t* tab, const uint8_t* seedHead,
+                                       const uint8_t* seedNext, MEM_QUAL const uint8_t* rstart,
+                                       TogRec* rec, uint8_t* tog, ViewSpan* probeEv,
+                                       ViewSpan** probeEnd);
+
+#define CUSTOM_W(off)  (*(volatile uint16_t*)(0xDFF000u + (off)))
+#define CUSTOM_L(off)  (*(volatile uint32_t*)(0xDFF000u + (off)))
+
+extern "C" void revs_plot_blit_sync(void)
+{
+    (void)CUSTOM_W(0x002);                          /* DMACONR: the first read can be early */
+    while (CUSTOM_W(0x002) & 0x4000u) { }           /* BBUSY */
+}
+
+/* The run-time choice and the chip buffers — from revs_plot_planes, i.e. once at start-up and
+   before the first sweep asks which scan to run. */
+static void togInit(void)
+{
+    s_togInited = 1u;
+#if defined(TERRAIN_BLIT_FORCE)
+    s_togOn = TERRAIN_BLIT_FORCE ? 1u : 0u;
+#else
+    s_togOn = (SysBase->AttnFlags & AFF_68020) ? 0u : 1u;   /* a 68000/68010 only */
+#endif
+    if (s_togOn) {
+        s_tog[0] = (uint8_t*)AllocMem(2u * TOG_ROWS * kRowBytes, MEMF_CHIP | MEMF_CLEAR);
+        if (s_tog[0]) s_tog[1] = s_tog[0] + TOG_ROWS * kRowBytes;
+        else          s_togOn = 0u;
+        CUSTOM_W(0x096) = 0x8240u;                  /* DMACON: SET | DMAEN | BLTEN */
+        /* ⚠ The toggle scan keeps only the probe line's list, so every other line's is
+           terminated once here — anything that ever walks one stops at once, not in BSS. */
+        {
+            unsigned l;
+            for (l = 0; l < 80u; l++) { g_viewEv[l][0].start = 0xFFu; g_viewEvEnd[l] = &g_viewEv[l][0]; }
+        }
+    }
+    g_terrainBlitOn = s_togOn;
+}
+
+static void blitClear_(uint8_t* dst);
+
+static void togRecord(unsigned r, unsigned colour)
+{
+    const unsigned lo = g_bbcExpandLo[colour], hi = g_bbcExpandHi[colour];
+    uint8_t* const t = s_togTab[r];
+    t[0] = (uint8_t)colour;  t[1] = 0;
+    t[2] = (uint8_t)(lo ^ (lo << 1));  t[3] = (uint8_t)(hi ^ (hi << 1));
+    t[4] = (uint8_t)(lo >> 7);         t[5] = (uint8_t)(hi >> 7);
+    t[6] = (uint8_t)(t[2] ^ t[4]);     t[7] = (uint8_t)(t[3] ^ t[5]);
+}
+
+/* ⚠ Built from the running machine's `view_cell_bytes`, on the first race sweep — never from a
+   remembered "identity with one hole": the oracle then covers the table as well. */
+static void togTabBuild(void)
+{
+    unsigned b;
+    for (b = 0; b < 256u; b++) togRecord(b, mem[MEM_view_cell_bytes + b]);
+    togRecord(256u, 0x55u);
+    s_togTabBuilt = 1u;
+}
+
+/* The scan's side of a sweep: run it into this sweep's buffer.  0 = not this path. */
+extern "C" int revs_plot_tog_scan(unsigned* found, const uint8_t* floor, const uint8_t* seedHead,
+                                  const uint8_t* seedNext)
+{
+    if (!s_togOn || !s_target) return 0;
+    if (!s_togTabBuilt) togTabBuild();
+    if (s_togFlip) {                                /* this sweep's buffer */
+        s_togFlip = 0u;
+        s_togCur ^= 1u;
+#if !(defined(TERRAIN_BLIT_SABOTAGE) && TERRAIN_BLIT_SABOTAGE == 3)   /* SABOTAGE 3: never cleared */
+        if (s_togDirty[s_togCur ^ 1u]) { blitClear_(s_tog[s_togCur ^ 1u]); s_togDirty[s_togCur ^ 1u] = 0u; }
+#endif
+    }
+    s_togDirty[s_togCur] = 1u;
+    *found = view_scan_tog_m68k(mem + MEM_view_src_blocks, floor, &s_togTab[0][0], seedHead,
+                                seedNext, mem + MEM_view_right_start_src, s_togRec,
+                                s_tog[s_togCur] - TOG_Y0 * kRowBytes,
+                                &g_viewEv[REVS_TOG_PROBE_LINE][0],
+                                &g_viewEvEnd[REVS_TOG_PROBE_LINE]);
+    return 1;
+}
+
+extern "C" int revs_plot_tog_on(void) { if (!s_togInited) togInit(); return s_togOn; }
+
+/* A run's interior when its colour is patterned: every cell but its last carries K. */
+static inline void togFill(uint8_t* row, unsigned from, unsigned to, const uint8_t* t)
+{
+    unsigned c;
+    for (c = from; c < to; c++) { row[c] = t[6]; row[c + kPlaneGap] = t[7]; }
+}
+
+/* What the scan could not write: the entry run, now that its byte is published, and the last run's
+   right-edge cell.  Sweep lines `first` down to `last`. */
+static void togFix(unsigned first, unsigned last)
+{
+    unsigned line;
+    for (line = first; ; line--) {
+        const TogRec& r = s_togRec[line];
+        uint8_t* const row = r.row;
+        const unsigned e  = g_viewRowBg[line];
+        const uint8_t* const te = s_togTab[e == 0x55u ? 256u : e];
+        if (r.firstc == 0xFFu) {                    /* no event: the entry is the whole line */
+            if (te[6] | te[7]) togFill(row, 0u, BBC_SCREEN_CELLS - 1u, te);
+            row[BBC_SCREEN_CELLS - 1u]             = te[2];
+            row[BBC_SCREEN_CELLS - 1u + kPlaneGap] = te[3];
+        } else {
+            const uint8_t* const tl = s_togTab[0] + r.prev;
+            const unsigned f = r.firstc;
+            if (f) {
+#if !(defined(TERRAIN_BLIT_SABOTAGE) && TERRAIN_BLIT_SABOTAGE == 4)   /* SABOTAGE 4: entry dropped */
+                row[f - 1u]             ^= te[2];
+                row[f - 1u + kPlaneGap] ^= te[3];
+#endif
+                if (te[6] | te[7]) togFill(row, 0u, f - 1u, te);
+            }
+            if (tl[6] | tl[7]) togFill(row, r.prevc, BBC_SCREEN_CELLS - 1u, tl);
+            row[BBC_SCREEN_CELLS - 1u]             = tl[2];
+            row[BBC_SCREEN_CELLS - 1u + kPlaneGap] = tl[3];
+        }
+        if (line == last) break;
+    }
+}
+
+static void blitFill(uint8_t* dst, const uint8_t* src, unsigned rows)
+{
+    const unsigned bytes = rows * kRowBytes;
+#if defined(TERRAIN_BLIT_SABOTAGE) && TERRAIN_BLIT_SABOTAGE == 5
+    (void)dst; (void)src; (void)bytes; return;      /* PRICING ARM 5: no fill (picture wrong) */
+#endif
+    revs_plot_blit_sync();
+    CUSTOM_W(0x040) = 0x09F0u;                      /* BLTCON0: USEA | USED, D = A */
+#if defined(TERRAIN_BLIT_SABOTAGE) && TERRAIN_BLIT_SABOTAGE == 2
+    CUSTOM_W(0x042) = 0x000Au;                      /* SABOTAGE 2: INCLUSIVE fill */
+#else
+    CUSTOM_W(0x042) = 0x0012u;                      /* BLTCON1: EFE | DESC */
+#endif
+    CUSTOM_W(0x044) = 0xFFFFu;                      /* BLTAFWM */
+    CUSTOM_W(0x046) = 0xFFFFu;                      /* BLTALWM */
+    CUSTOM_L(0x050) = (uint32_t)(src + bytes - 2u); /* BLTAPT: descending = the last word */
+    CUSTOM_L(0x054) = (uint32_t)(dst + bytes - 2u); /* BLTDPT */
+    CUSTOM_W(0x064) = 0u;                           /* BLTAMOD */
+    CUSTOM_W(0x066) = 0u;                           /* BLTDMOD */
+    CUSTOM_W(0x058) = (uint16_t)(((2u * rows) << 6) | (kPlaneGap / 2u));   /* BLTSIZE: go */
+}
+
+static void blitClear_(uint8_t* dst)
+{
+    revs_plot_blit_sync();
+    CUSTOM_W(0x040) = 0x0100u;                      /* USED, minterm 0 */
+    CUSTOM_W(0x042) = 0x0000u;
+    CUSTOM_L(0x054) = (uint32_t)dst;
+    CUSTOM_W(0x066) = 0u;
+    CUSTOM_W(0x058) = (uint16_t)(((2u * TOG_ROWS) << 6) | (kPlaneGap / 2u));
+}
+
+#else
+extern "C" void revs_plot_blit_sync(void) { }
+#endif
+
 extern "C" void revs_plot_terrain(unsigned first, unsigned last)
 {
     unsigned line;
@@ -552,6 +770,34 @@ extern "C" void revs_plot_terrain(unsigned first, unsigned last)
             const unsigned y0 = s_lineOf[off0], n = first - last + 1u;
             uint16_t* sig = 0;
             unsigned  b;
+#ifdef REVS_TERRAIN_BLIT
+            if (s_togOn) {
+                /* ⭐ The scan has already written this block's toggles (revs_plot_tog_scan); the
+                   rows it wrote are sweep line L's at display row 160 - L, so a block anywhere
+                   else would fill from the wrong rows — it cannot happen (both drivers step one
+                   row a line from the game's own immediates) and it is counted if it does. */
+                __builtin_memset(&g_plotOwn[y0], 1, n);
+                if (y0 + first != 2u * TOG_Y0 || y0 < TOG_Y0 || y0 + n > TOG_Y0 + TOG_ROWS) {
+                    g_togMapBad++;
+                    return;
+                }
+                togFix(first, last);
+                blitFill(s_target + s_planeOff[off0], s_tog[s_togCur] + (y0 - TOG_Y0) * kRowBytes, n);
+                g_terrainBlits++;
+                TSIG_STALE();
+#ifdef REVS_TERRAIN_CHECK
+                revs_plot_blit_sync();          /* the oracle reads what the blit wrote */
+                for (line = first; ; line--) {
+                    const unsigned off = (unsigned)g_viewRowAddr[line] - BBC_SCREEN_BASE;
+                    if (off >= FB_BYTES || s_lineOf[off] != y0 + (first - line)) g_terrainRowBad++;
+                    else terrain_check_line(off, g_viewRowBg[line], &g_viewEv[line][0]);
+                    if (line == last) break;
+                }
+#endif
+                (void)sig; (void)b;
+                return;
+            }
+#endif
             /* the claim, which the asm used to make a byte a row: every row is the painter's */
             __builtin_memset(&g_plotOwn[y0], 1, n);
             if (s_tsigStale) {
@@ -762,6 +1008,9 @@ extern "C" void revs_plot_planes(unsigned char* planeA, unsigned char* planeB)
        display is up, which is the only place 16.6 KB of table fill is free — and it retires the
        lazy build the geometry comment above warns about. */
     if (!s_mapBuilt) buildMap();
+#ifdef REVS_TERRAIN_BLIT
+    if (!s_togInited) togInit();
+#endif
 }
 
 /* ── ⭐⭐⭐ THE TAKEOVER'S OWN LINE (docs/span-render-plan.md §10p step 3b) ────────────────────
@@ -1915,6 +2164,9 @@ extern "C" void revs_needle_paint(void)
    sweep's spans instead of repainting stale mem[] over them. */
 extern "C" void revs_plot_own_reset(void)
 {
+#ifdef REVS_TERRAIN_BLIT
